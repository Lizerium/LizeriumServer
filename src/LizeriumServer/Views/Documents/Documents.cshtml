@inject IViewLocalizer Localizer
@model DocumentViewModel
@{
    ViewData["Title"] = Localizer["Documents_Title_Site"];
}

<div class="main-news">
    <section class="news-section lizerium-section-page info lizerium-section-page-knowledge">
        <header class="lizerium-page-hero lizerium-page-hero-knowledge">
            <div class="lizerium-page-hero-copy">
                <span class="lizerium-page-hero-icon" aria-hidden="true">
                    <span class="nav-icon nav-icon-knowledge" aria-hidden="true"></span>
                </span>
                <div>
                    <h1>@Localizer["Documents_Header"]</h1>
                    <p>@Localizer["Documents_Page_Description"]</p>
                </div>
            </div>
        </header>
        <div class="lizerium-docs-section-heading">
            <span></span>
            <h2>@Localizer["Documents_Section_Main"]</h2>
            <span></span>
        </div>
        <div class="lizerium-docs-grid lizerium-docs-primary-grid">
            <a class="lizerium-doc-card lizerium-doc-card-primary custom-cursor-hover" href="/wiki">
                <span class="lizerium-doc-card-icon lizerium-doc-icon lizerium-doc-icon-knowledge" aria-hidden="true"></span>
                <strong>@Localizer["Documents_Wiki"]</strong>
                <small>@Localizer["Documents_Wiki_Sub"]</small>
                <em>→</em>
            </a>
            <a class="lizerium-doc-card lizerium-doc-card-primary custom-cursor-hover" href="/docs/install">
                <span class="lizerium-doc-card-icon lizerium-doc-icon lizerium-doc-icon-knowledge" aria-hidden="true"></span>
                <strong>@Localizer["Documents_Install"]</strong>
                <small>@Localizer["Documents_Install_Sub"]</small>
                <em>→</em>
            </a>
        </div>

        <section class="lizerium-docs-server-section" aria-labelledby="lizerium-docs-server-title">
            <div class="lizerium-docs-server-heading">
                <span class="lizerium-docs-server-icon lizerium-doc-icon lizerium-doc-icon-server" aria-hidden="true"></span>
                <div>
                    <h2 id="lizerium-docs-server-title">@Localizer["Documents_Section_Server"]</h2>
                    <p>@Localizer["Documents_Section_Server_Description"]</p>
                </div>
            </div>
            <div class="lizerium-docs-grid lizerium-docs-server-grid">
                <a class="lizerium-doc-card lizerium-doc-card-server custom-cursor-hover" href="/docs/hook">
                    <span class="lizerium-doc-card-icon lizerium-doc-card-server-icon lizerium-doc-icon lizerium-doc-icon-server" aria-hidden="true"></span>
                    <strong>@Localizer["Documents_Commands_Hook"]</strong>
                    <small>@Localizer["Documents_Commands_Hook_Sub"]</small>
                    <em>→</em>
                </a>
                <a class="lizerium-doc-card lizerium-doc-card-server custom-cursor-hover" href="/docs/builds">
                    <span class="lizerium-doc-card-icon lizerium-doc-card-server-icon lizerium-doc-icon lizerium-doc-icon-server" aria-hidden="true"></span>
                    <strong>@Localizer["Documents_Builds"]</strong>
                    <small>@Localizer["Documents_Builds_Sub"]</small>
                    <em>→</em>
                </a>
            </div>
        </section>
    </section>
</div>
