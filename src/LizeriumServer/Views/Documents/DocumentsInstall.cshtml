@inject IViewLocalizer Localizer
@model DocumentViewModel
@{
    ViewData["Title"] = Localizer["DocInstall_Title_Site"];
}
@section PageStyle {
    <link rel="stylesheet" href="~/css/doc_hook.min.css" asp-append-version="true" />
}

<section class="doc-hook-page doc-install-page">
    <header class="doc-hook-hero doc-install-hero lizerium-reveal">
        <span class="doc-hook-hero-icon doc-install-hero-icon" aria-hidden="true">
            <img src="~/img/nav/knowledge.webp" alt="" />
        </span>
        <div class="doc-hook-hero-copy">
            <span>@Localizer["DocInstall_Kicker"]</span>
            <h1>@Localizer["DocInstall_Header"]</h1>
            <p>@Localizer["DocInstall_Description"]</p>
        </div>
    </header>

    <article class="markdown-body doc-hook-shell doc-install-shell lizerium-reveal">
        <a class="doc-hook-back custom-cursor-hover" href="/docs/all">
            <span class="doc-hook-back-icon" aria-hidden="true">&#8617;</span>
            <span>@SharedLocalizer["Shared_Docs"]</span>
        </a>

        <section class="doc-install-panel">
            <div class="doc-install-status">
                <span>@Localizer["DocInstall_Status"]</span>
            </div>
            <div class="doc-install-content">
                <span>@Localizer["DocInstall_Panel_Label"]</span>
                <h2>@Localizer["DocInstall_Panel_Title"]</h2>
                <p>@Localizer["DocInstall_Panel_Text"]</p>
            </div>
            <div class="doc-install-roadmap" aria-label="@Localizer["DocInstall_Roadmap_Label"]">
                <div>
                    <strong>01</strong>
                    <span>@Localizer["DocInstall_Point_Install"]</span>
                </div>
                <div>
                    <strong>02</strong>
                    <span>@Localizer["DocInstall_Point_Config"]</span>
                </div>
                <div>
                    <strong>03</strong>
                    <span>@Localizer["DocInstall_Point_Check"]</span>
                </div>
            </div>
        </section>
    </article>
</section>
