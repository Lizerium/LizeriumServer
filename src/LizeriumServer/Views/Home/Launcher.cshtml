@model LauncherViewModel
@section PageStyle {
    <link rel="stylesheet" href="~/css/news.min.css" asp-append-version="true" />
}
@using LizeriumServer.Helpers
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.RegularExpressions
@using LizeriumUtilities.Accessories.NewsAccessories
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Launcher_Title_Site"];
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRussian = culture.Equals("ru", StringComparison.OrdinalIgnoreCase);
    var orderFilter = string.IsNullOrWhiteSpace(Model.SortOrderFilter) ? "new" : Model.SortOrderFilter;
    var platformFilter = Model.PlatformFilter ?? string.Empty;
    var typeFilter = Model.TypeFilter ?? string.Empty;
    var searchPlaceholder = Localizer["Launcher_Search_Placeholder"].Value;
    var orderLabel = Localizer["Launcher_Order_Label"].Value;
    var newLabel = Localizer["Launcher_Order_New"].Value;
    var oldLabel = Localizer["Launcher_Order_Old"].Value;
    var searchButtonLabel = Localizer["Launcher_Search_Button"].Value;
    var filterLabel = Localizer["Launcher_Filter_Button"].Value;
    var filterDialogTitle = Localizer["Launcher_Filter_Dialog_Title"].Value;
    var filterDialogDescription = Localizer["Launcher_Filter_Dialog_Description"].Value;
    var filterPlatformLabel = Localizer["Launcher_Filter_Platform"].Value;
    var filterPlatformAllLabel = Localizer["Launcher_Filter_Platform_All"].Value;
    var filterGithubLabel = Localizer["Launcher_Filter_Github"].Value;
    var filterTypeLabel = Localizer["Launcher_Filter_Type"].Value;
    var filterTypeAllLabel = Localizer["Launcher_Filter_Type_All"].Value;
    var filterApplyLabel = Localizer["Launcher_Filter_Apply"].Value;
    var filterResetLabel = Localizer["Launcher_Filter_Reset"].Value;
    var previousImageLabel = Localizer["Launcher_Previous_Image"].Value;
    var nextImageLabel = Localizer["Launcher_Next_Image"].Value;
    var videoPlatformsLabel = Localizer["Launcher_Video_Platforms"].Value;
    var likeLabel = Localizer["Launcher_Like"].Value;
    var readFullLabel = Localizer["Launcher_Read_Full"].Value;
    var shareLabel = Localizer["Launcher_Share"].Value;
    var shareCopiedLabel = Localizer["Launcher_ShareCopied"].Value;
    var newsNavigationLabel = Localizer["Launcher_News_Navigation"].Value;
    var closeLabel = Localizer["Launcher_Close"].Value;
    var newerLabel = Localizer["Launcher_Newer"].Value;
    var olderLabel = Localizer["Launcher_Older"].Value;
    var videoBlockedTemplate = Localizer["Launcher_Video_Blocked_Template"].Value;
    var genericVideoPlatformLabel = Localizer["Launcher_Video_Generic_Platform"].Value;
}
@functions {
    private sealed class NewsVideoPlatform
    {
        public string Key { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public string IconUrl { get; init; } = string.Empty;
        public string Url { get; init; } = string.Empty;
        public string EmbedUrl { get; init; } = string.Empty;
        public string PosterUrl { get; init; } = string.Empty;
    }

    private static string PickText(string primary, string fallback)
    {
        return !string.IsNullOrWhiteSpace(primary) ? primary : fallback ?? string.Empty;
    }

    private static string BuildYoutubeEmbedUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return string.Empty;

        var match = Regex.Match(url, @"(?:youtube\.com/watch\?v=|youtube\.com/embed/|youtube\.com/shorts/|youtu\.be/)([A-Za-z0-9_-]{6,})", RegexOptions.IgnoreCase);
        return match.Success ? $"https://www.youtube.com/embed/{match.Groups[1].Value}" : string.Empty;
    }

    private static string BuildYoutubePosterUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return string.Empty;

        var match = Regex.Match(url, @"(?:youtube\.com/watch\?v=|youtube\.com/embed/|youtube\.com/shorts/|youtu\.be/)([A-Za-z0-9_-]{6,})", RegexOptions.IgnoreCase);
        return match.Success ? $"https://img.youtube.com/vi/{match.Groups[1].Value}/hqdefault.jpg" : string.Empty;
    }

    private static string BuildRutubeEmbedUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return string.Empty;

        var match = Regex.Match(url, @"rutube\.ru/(?:video|play/embed)/([A-Za-z0-9]+)", RegexOptions.IgnoreCase);
        return match.Success ? $"https://rutube.ru/play/embed/{match.Groups[1].Value}/" : string.Empty;
    }

    private static string BuildRutubePosterUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return string.Empty;

        var match = Regex.Match(url, @"rutube\.ru/(?:video|play/embed)/([A-Za-z0-9]+)", RegexOptions.IgnoreCase);
        return match.Success ? $"https://rutube.ru/api/video/{match.Groups[1].Value}/thumbnail/?redirect=1" : string.Empty;
    }

    private static string BuildVkEmbedUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return string.Empty;

        var oidMatch = Regex.Match(url, @"(?:video|clip)(-?\d+)_(\d+)", RegexOptions.IgnoreCase);
        if (oidMatch.Success)
            return $"https://vk.com/video_ext.php?oid={oidMatch.Groups[1].Value}&id={oidMatch.Groups[2].Value}";

        return string.Empty;
    }

    private static string PickVideoUrl(LizeriumUtilities.FormatsData.DataBase.Response.LauncherNewsDataResponse news, bool isRussian)
    {
        return GetVideoPlatforms(news, isRussian).FirstOrDefault()?.EmbedUrl ?? string.Empty;
    }

    private static List<NewsVideoPlatform> GetVideoPlatforms(LizeriumUtilities.FormatsData.DataBase.Response.LauncherNewsDataResponse news, bool isRussian)
    {
        var platforms = new List<NewsVideoPlatform>();
        var youtube = BuildYoutubeEmbedUrl(news.YoutubeUrl);
        var rutube = BuildRutubeEmbedUrl(news.RutubeUrl);
        var vk = BuildVkEmbedUrl(news.VkVideoUrl);

        if (!string.IsNullOrWhiteSpace(youtube))
        {
            platforms.Add(new NewsVideoPlatform
            {
                Key = "youtube",
                Name = "YouTube",
                IconUrl = "/img/social/youtube.webp",
                Url = news.YoutubeUrl,
                EmbedUrl = youtube,
                PosterUrl = BuildYoutubePosterUrl(news.YoutubeUrl)
            });
        }

        if (!string.IsNullOrWhiteSpace(rutube))
        {
            platforms.Add(new NewsVideoPlatform
            {
                Key = "rutube",
                Name = "Rutube",
                IconUrl = "/img/social/rutube.webp",
                Url = news.RutubeUrl,
                EmbedUrl = rutube,
                PosterUrl = BuildRutubePosterUrl(news.RutubeUrl)
            });
        }

        if (!string.IsNullOrWhiteSpace(vk))
        {
            platforms.Add(new NewsVideoPlatform
            {
                Key = "vk",
                Name = "VK",
                IconUrl = "/img/social/vk.webp",
                Url = news.VkVideoUrl,
                EmbedUrl = vk
            });
        }

        var preferredOrder = isRussian
            ? new[] { "rutube", "vk", "youtube" }
            : new[] { "youtube", "vk", "rutube" };

        return platforms
            .OrderBy(platform =>
            {
                var index = Array.IndexOf(preferredOrder, platform.Key);
                return index < 0 ? int.MaxValue : index;
            })
            .ToList();
    }

    private static string PickNewsType(LizeriumUtilities.FormatsData.DataBase.Response.LauncherNewsDataResponse news, bool isRussian)
    {
        var localized = isRussian ? news.NewsTypeRu : news.NewsTypeEn;
        if (!string.IsNullOrWhiteSpace(localized))
            return localized;

        var fallback = isRussian ? news.NewsTypeEn : news.NewsTypeRu;
        if (!string.IsNullOrWhiteSpace(fallback))
            return fallback;

        if (!string.IsNullOrWhiteSpace(news.NewsType))
            return news.NewsType;

        return isRussian ? "\u041d\u043e\u0432\u043e\u0441\u0442\u044c" : "News";
    }
    private static string PickIconUrl(LizeriumUtilities.FormatsData.DataBase.Response.LauncherNewsDataResponse news)
    {
        var iconUrl = news.IconUrl?.Trim() ?? string.Empty;
        if (iconUrl.Equals("/img/96_ico_no_fon.ico", StringComparison.OrdinalIgnoreCase))
            iconUrl = string.Empty;

        return !string.IsNullOrWhiteSpace(iconUrl)
            ? iconUrl
            : "/img/Main.webp";
    }

    private static string PickCoverImage(LizeriumUtilities.FormatsData.DataBase.Response.LauncherNewsDataResponse news)
    {
        return !string.IsNullOrWhiteSpace(news.ImageUrl) ? news.ImageUrl.Trim() : string.Empty;
    }

    private static List<string> GetGalleryImages(LizeriumUtilities.FormatsData.DataBase.Response.LauncherNewsDataResponse news, string markdown)
    {
        var images = new List<string>();
        if (!string.IsNullOrWhiteSpace(news.ImageGalleryJson))
        {
            try
            {
                var gallery = JsonSerializer.Deserialize<List<string>>(news.ImageGalleryJson);
                if (gallery != null)
                    images.AddRange(gallery);
            }
            catch
            {
                images.AddRange(news.ImageGalleryJson.Split(new[] { "\r\n", "\n", ";", "," }, StringSplitOptions.RemoveEmptyEntries));
            }
        }

        var cover = PickCoverImage(news);
        var inlineImages = GetMarkdownImages(markdown);

        return images
            .Where(image => !string.IsNullOrWhiteSpace(image))
            .Select(image => image.Trim())
            .Where(image => !image.Equals(cover, StringComparison.OrdinalIgnoreCase))
            .Where(image => !inlineImages.Contains(image, StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static List<string> GetMarkdownImages(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return new List<string>();

        return Regex.Matches(markdown, @"!\[[^\]]*\]\(([^)]+)\)")
            .Select(match => match.Groups[1].Value.Trim())
            .Where(image => !string.IsNullOrWhiteSpace(image))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static List<string> GetMarkdownVideos(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return new List<string>();

        var videos = new List<string>();
        var inFence = false;
        foreach (var line in markdown.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
        {
            var trimmed = line.Trim();
            if (trimmed.StartsWith("```", StringComparison.Ordinal) || trimmed.StartsWith("~~~", StringComparison.Ordinal))
            {
                inFence = !inFence;
                continue;
            }

            if (inFence)
                continue;

            var macro = Regex.Match(trimmed, @"^@video(?:-vertical)?\((?<url>https?://[^)\s]+)\)$", RegexOptions.IgnoreCase);
            var url = macro.Success ? macro.Groups["url"].Value : trimmed;
            if (!Regex.IsMatch(url, @"^https?://\S+$", RegexOptions.IgnoreCase))
                continue;

            var embedUrl = BuildYoutubeEmbedUrl(url);
            if (string.IsNullOrWhiteSpace(embedUrl))
                embedUrl = BuildRutubeEmbedUrl(url);
            if (string.IsNullOrWhiteSpace(embedUrl))
                embedUrl = BuildVkEmbedUrl(url);

            if (!string.IsNullOrWhiteSpace(embedUrl))
                videos.Add(url);
        }

        return videos.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static string StripNewsText(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        var text = Regex.Replace(markdown, @"!\[[^\]]*\]\([^)]+\)", string.Empty);
        text = Regex.Replace(text, @"^\s*@video(?:-vertical)?\(https?://[^)\s]+\)\s*$", string.Empty, RegexOptions.IgnoreCase | RegexOptions.Multiline);
        text = Regex.Replace(text, @"^\s*https?://(?:www\.)?(?:youtube\.com/watch\?v=|youtube\.com/embed/|youtube\.com/shorts/|youtu\.be/|rutube\.ru/(?:video|play/embed)/|vk\.com/(?:video|clip))\S+\s*$", string.Empty, RegexOptions.IgnoreCase | RegexOptions.Multiline);
        text = Regex.Replace(text, @"\[([^\]]+)\]\([^)]+\)", "$1");
        text = Regex.Replace(text, @"[#>*_`~\-]+", " ");
        return Regex.Replace(text, @"\s+", " ").Trim();
    }

    private static string BuildNewsCardHtml(string markdown, string fallbackText = "")
    {
        var firstLine = markdown?
            .Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.None)
            .FirstOrDefault() ?? string.Empty;

        var cardMarkdown = RemoveNewsCardMedia(firstLine);
        if (!string.IsNullOrWhiteSpace(cardMarkdown))
        {
            var html = ToInlineNewsCardHtml(MarkdownHtmlHelper.ToSafeHtml(cardMarkdown, true));
            if (!string.IsNullOrWhiteSpace(html))
                return html;
        }

        var text = StripNewsText(cardMarkdown);
        if (string.IsNullOrWhiteSpace(text))
            text = StripNewsText(fallbackText);

        return string.IsNullOrWhiteSpace(text)
            ? string.Empty
            : HtmlEncoder.Default.Encode(text);
    }

    private static string RemoveNewsCardMedia(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        var contentLines = string.Join("\n", markdown
            .Replace("\r\n", "\n")
            .Replace('\r', '\n')
            .Split('\n')
            .Select(line => line.Trim())
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .Where(line => !IsNewsCardSkippedMarkdownLine(line))
            .Select(RemoveNewsCardInlineMedia)
            .Where(line => !string.IsNullOrWhiteSpace(line)));

        return contentLines.Trim();
    }

    private static bool IsNewsCardSkippedMarkdownLine(string line)
    {
        return Regex.IsMatch(line, @"^!\[[^\]]*\]\([^)]+\)$")
            || Regex.IsMatch(line, @"^@video(?:-vertical)?\(https?://[^)\s]+\)$", RegexOptions.IgnoreCase)
            || Regex.IsMatch(line, @"^https?://(?:www\.)?(?:youtube\.com/watch\?v=|youtube\.com/embed/|youtube\.com/shorts/|youtu\.be/|rutube\.ru/(?:video|play/embed)/|vk\.com/(?:video|clip)|vkvideo\.ru/video)\S+$", RegexOptions.IgnoreCase);
    }

    private static string RemoveNewsCardInlineMedia(string line)
    {
        var withoutImages = Regex.Replace(line, @"!\[[^\]]*\]\([^)]+\)", string.Empty);
        return Regex.Replace(withoutImages, @"@video(?:-vertical)?\(https?://[^)\s]+\)", string.Empty, RegexOptions.IgnoreCase).Trim();
    }

    private static string ToInlineNewsCardHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return string.Empty;

        var inline = Regex.Replace(html, @"</p>\s*<p>", " ", RegexOptions.IgnoreCase);
        inline = Regex.Replace(inline, @"</?(?:p|h[1-6]|ul|ol|li|blockquote)[^>]*>", " ", RegexOptions.IgnoreCase);
        inline = Regex.Replace(inline, @"<br\s*/?>", " ", RegexOptions.IgnoreCase);
        return Regex.Replace(inline, @"\s+", " ").Trim();
    }

    private static bool ShouldShowFullRead(string markdown, int imageCount, bool hasVideo)
    {
        var text = StripNewsText(markdown);
        if (text.Length == 0)
            return imageCount > 0 || hasVideo || GetMarkdownVideos(markdown).Count > 0;

        return text.Length > 260 || imageCount > 0 || GetMarkdownImages(markdown).Count > 0 || GetMarkdownVideos(markdown).Count > 0 || (hasVideo && text.Length > 80);
    }
}
<article>
    <section class="news-section launcher-news-page"
             data-news-video-blocked-template="@videoBlockedTemplate"
             data-news-video-generic-platform="@genericVideoPlatformLabel"
             data-news-initial-open="@(Model.OpenNewsId > 0 ? Model.OpenNewsId.ToString(CultureInfo.InvariantCulture) : null)">
        <div class="container-fluid">
            <header class="launcher-news-hero">
                <div class="launcher-news-hero-copy">
                    <span class="launcher-news-hero-icon" aria-hidden="true"></span>
                    <div>
                        <h1>@Localizer["Launcher_Header"]</h1>
                        <p>@Localizer["Launcher_Description"]</p>
                    </div>
                </div>
                <div class="launcher-news-hero-banner" aria-hidden="true"></div>
            </header>

            <form class="launcher-news-toolbar" method="get" action="@Url.Action("Launcher", "Home")">
                <label class="launcher-news-search">
                    <span aria-hidden="true"></span>
                    <input name="search" value="@Model.Search" placeholder="@searchPlaceholder" />
                    <button class="launcher-news-search-button" type="submit" name="order" value="@orderFilter" aria-label="@searchButtonLabel"></button>
                </label>
                <div class="launcher-news-sort" role="group" aria-label="@orderLabel">
                    <button class="@(orderFilter == "new" ? "active" : string.Empty)" type="submit" name="order" value="new">
                        @newLabel
                    </button>
                    <button class="@(orderFilter == "old" ? "active" : string.Empty)" type="submit" name="order" value="old">
                        @oldLabel
                    </button>
                </div>
                <button class="launcher-news-filter-button" type="button" data-launcher-filter-open>
                    <span aria-hidden="true"></span>
                    @filterLabel
                </button>
                <dialog class="launcher-news-filter-dialog" data-launcher-filter-dialog>
                    <div class="launcher-news-filter-dialog-header">
                        <span class="launcher-news-hero-icon" aria-hidden="true"></span>
                        <div>
                            <h2>@filterDialogTitle</h2>
                            <p>@filterDialogDescription</p>
                        </div>
                        <button type="button" class="launcher-news-filter-close" data-launcher-filter-close aria-label="@closeLabel">&times;</button>
                    </div>
                    <div class="launcher-news-filter-group">
                        <strong>@filterPlatformLabel</strong>
                        <div class="launcher-news-filter-options">
                            <label><input type="radio" name="platform" value="" checked="@(string.IsNullOrWhiteSpace(platformFilter))" /> <span>@filterPlatformAllLabel</span></label>
                            <label><input type="radio" name="platform" value="youtube" checked="@(platformFilter == "youtube")" /> <span>YouTube</span></label>
                            <label><input type="radio" name="platform" value="rutube" checked="@(platformFilter == "rutube")" /> <span>Rutube</span></label>
                            <label><input type="radio" name="platform" value="vk" checked="@(platformFilter == "vk")" /> <span>VK</span></label>
                        </div>
                    </div>
                    <div class="launcher-news-filter-group">
                        <strong>@filterGithubLabel</strong>
                        <label class="launcher-news-filter-check"><input type="checkbox" name="github" value="true" checked="@Model.GithubFilter" /> <span>GitHub</span></label>
                    </div>
                    <div class="launcher-news-filter-group">
                        <strong>@filterTypeLabel</strong>
                        <select name="type">
                            <option value="">@filterTypeAllLabel</option>
                            @foreach (var newsType in Model.NewsTypes)
                            {
                                <option value="@newsType" selected="@(string.Equals(typeFilter, newsType, StringComparison.OrdinalIgnoreCase))">@newsType</option>
                            }
                        </select>
                    </div>
                    <div class="launcher-news-filter-actions">
                        <a href="@Url.Action("Launcher", "Home", new { search = Model.Search, order = orderFilter })">@filterResetLabel</a>
                        <button type="submit" name="order" value="@orderFilter">@filterApplyLabel</button>
                    </div>
                </dialog>
            </form>

            <div class="launcher-news-grid">
                @foreach (var news in Model.News)
                {
                    var title = isRussian
                        ? PickText(news.TitleRu, news.TitleEn)
                        : PickText(news.TitleEn, news.TitleRu);
                    var markdown = isRussian
                        ? PickText(news.MarkdownRu, news.MarkdownEn)
                        : PickText(news.MarkdownEn, news.MarkdownRu);
                    var videoPlatforms = GetVideoPlatforms(news, isRussian);
                    var videoUrl = videoPlatforms.FirstOrDefault()?.EmbedUrl ?? string.Empty;
                    var coverImage = PickCoverImage(news);
                    var galleryImages = GetGalleryImages(news, markdown);
                    var cardImages = new List<string>();
                    if (!string.IsNullOrWhiteSpace(coverImage))
                    {
                        cardImages.Add(coverImage);
                    }
                    else if (galleryImages.Count > 0)
                    {
                        cardImages.Add(galleryImages[0]);
                    }
                    else
                    {
                        var inlineImages = GetMarkdownImages(markdown);
                        if (inlineImages.Count > 0)
                            cardImages.Add(inlineImages[0]);
                        else
                        {
                            var videoPoster = videoPlatforms.FirstOrDefault(platform => !string.IsNullOrWhiteSpace(platform.PosterUrl))?.PosterUrl;
                            if (!string.IsNullOrWhiteSpace(videoPoster))
                                cardImages.Add(videoPoster);
                        }
                    }
                    var hasBody = !string.IsNullOrWhiteSpace(markdown);
                    var canReadFull = ShouldShowFullRead(markdown, galleryImages.Count, videoPlatforms.Count > 0);
                    var cardFallbackText = PickText(news.GithubProjectName, title);
                    var cardHtml = BuildNewsCardHtml(markdown, cardFallbackText);
                    var hasCardMedia = cardImages.Count > 0 || videoPlatforms.Count > 0;
                    var hasInlineMedia = GetMarkdownImages(markdown).Count > 0 || GetMarkdownVideos(markdown).Count > 0;
                    var date = news.PublishedAtUnix > 0
                        ? DateTimeOffset.FromUnixTimeSeconds(news.PublishedAtUnix).ToLocalTime().ToString("dd.MM.yyyy")
                        : string.Empty;
                    var newsType = PickNewsType(news, isRussian);
                    var canonicalNewsPath = news.GetCanonicalNewsPath(culture);

                    <article class="launcher-news-card @(hasBody ? "has-body" : "compact") @(hasCardMedia ? "has-media" : "no-media") @(hasInlineMedia ? "has-inline-media" : string.Empty)" id="news-card-@news.Id">
                        @if (videoPlatforms.Count > 0 && cardImages.Count > 0)
                        {
                            <button class="launcher-news-media launcher-news-video-poster"
                                    type="button"
                                    data-news-reader-open="@news.Id"
                                    data-news-reader-platform="@(videoPlatforms.FirstOrDefault()?.Key ?? string.Empty)"
                                    aria-label="@readFullLabel">
                                <img src="@cardImages[0]" alt="@title" loading="lazy" onerror="this.closest('.launcher-news-media')?.remove();" />
                                <span aria-hidden="true"></span>
                            </button>
                        }
                        else if (videoPlatforms.Count > 0)
                        {
                            <div class="launcher-news-media launcher-news-card-video" data-news-card-video>
                                <iframe loading="lazy"
                                        data-news-card-video-frame
                                        data-news-reader-video-src="@videoUrl"
                                        frameborder="0"
                                        allow="clipboard-write; autoplay; encrypted-media; picture-in-picture"
                                        allowfullscreen
                                        webkitallowfullscreen
                                        mozallowfullscreen>
                                </iframe>
                            </div>
                        }
                        else if (cardImages.Count > 0)
                        {
                            <div class="launcher-news-media image-block launcher-news-carousel" data-news-carousel>
                                @for (var imageIndex = 0; imageIndex < cardImages.Count; imageIndex++)
                                {
                                    <button class="launcher-news-image-button @(imageIndex == 0 ? "active" : string.Empty)"
                                            type="button"
                                            data-news-lightbox="@cardImages[imageIndex]"
                                            data-news-title="@title">
                                        <img src="@cardImages[imageIndex]" alt="@title" loading="lazy" onerror="var media=this.closest('.launcher-news-media');this.closest('.launcher-news-image-button')?.remove();if(media&&!media.querySelector('img'))media.remove();" />
                                    </button>
                                }
                                @if (cardImages.Count > 1)
                                {
                                    <button class="launcher-news-carousel-arrow previous" type="button" data-news-carousel-previous aria-label="@previousImageLabel">&lsaquo;</button>
                                    <button class="launcher-news-carousel-arrow next" type="button" data-news-carousel-next aria-label="@nextImageLabel">&rsaquo;</button>
                                    <div class="launcher-news-carousel-count"><span data-news-carousel-current>1</span>/@cardImages.Count</div>
                                }
                            </div>
                        }
                        <div class="launcher-news-content">
                            <div class="launcher-news-meta-row">
                                <span class="launcher-news-type-badge">@newsType</span>
                                @if (!string.IsNullOrWhiteSpace(date))
                                {
                                    <time>@date</time>
                                }
                            </div>
                            <h2>@title</h2>
                            @if (!string.IsNullOrWhiteSpace(cardHtml))
                            {
                                <div class="launcher-news-markdown">
                                    @Html.Raw(cardHtml)
                                </div>
                            }
                            @if (videoPlatforms.Count > 0)
                            {
                                <div class="launcher-news-video-links" aria-label="@videoPlatformsLabel">
                                    @foreach (var platform in videoPlatforms)
                                    {
                                        <button type="button"
                                                class="@(platform.Key == videoPlatforms[0].Key ? "active" : string.Empty)"
                                                data-news-card-video-platform="@platform.Key"
                                                data-news-card-video-src="@platform.EmbedUrl"
                                                title="@platform.Name">
                                            <img src="@platform.IconUrl" alt="@platform.Name" />
                                            <span>@platform.Name</span>
                                        </button>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(news.GithubUrl))
                            {
                                <a class="launcher-news-github" href="@news.GithubUrl" target="_blank" rel="noopener noreferrer">
                                    <img src="/img/github-mark.svg" alt="" aria-hidden="true" />
                                    <span>@PickText(news.GithubProjectName, "GitHub")</span>
                                </a>
                            }
                            <div class="launcher-news-card-actions">
                                <button class="launcher-news-like-box launcher-news-like-button"
                                        type="button"
                                        data-news-like="@news.Id"
                                            aria-label="@likeLabel">
                                    <span class="launcher-news-like-icon" aria-hidden="true"></span>
                                    <strong data-news-like-count>@Math.Max(0, news.LikeCount)</strong>
                                </button>
                                @if (canReadFull)
                                {
                                    <a class="launcher-news-read-button"
                                       href="@canonicalNewsPath"
                                       data-news-reader-open="@news.Id"
                                       data-news-reader-platform="@(videoPlatforms.FirstOrDefault()?.Key ?? string.Empty)">
                                        @readFullLabel
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="launcher-news-reader" data-news-reader aria-hidden="true">
                <div class="launcher-news-reader-backdrop" data-news-reader-close></div>
                <div class="launcher-news-reader-feed" data-news-reader-feed>
                    @foreach (var news in Model.News)
                    {
                        var title = isRussian
                            ? PickText(news.TitleRu, news.TitleEn)
                            : PickText(news.TitleEn, news.TitleRu);
                        var markdown = isRussian
                            ? PickText(news.MarkdownRu, news.MarkdownEn)
                            : PickText(news.MarkdownEn, news.MarkdownRu);
                        var videoPlatforms = GetVideoPlatforms(news, isRussian);
                        var videoUrl = videoPlatforms.FirstOrDefault()?.EmbedUrl ?? string.Empty;
                        var coverImage = PickCoverImage(news);
                        var galleryImages = GetGalleryImages(news, markdown);
                        var date = news.PublishedAtUnix > 0
                            ? DateTimeOffset.FromUnixTimeSeconds(news.PublishedAtUnix).ToLocalTime().ToString("dd.MM.yyyy")
                            : string.Empty;
                        var newsType = PickNewsType(news, isRussian);
                        var iconUrl = PickIconUrl(news);
                        var canonicalNewsPath = news.GetCanonicalNewsPath(culture);

                        <article class="launcher-news-reader-post" data-news-reader-post="@news.Id">
                            <header class="launcher-news-reader-header">
                                <div class="launcher-news-reader-titlebar">
                                    <img class="launcher-news-reader-icon" src="@iconUrl" alt="" loading="lazy" onerror="this.onerror=null;this.src='/img/Main.webp';" />
                                    <div>
                                        <div class="launcher-news-reader-meta">
                                            <span>@newsType</span>
                                            @if (!string.IsNullOrWhiteSpace(date))
                                            {
                                                <time>@date</time>
                                            }
                                        </div>
                                        <h2>@title</h2>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(coverImage))
                                {
                                    <button class="launcher-news-reader-banner"
                                            type="button"
                                            data-news-lightbox="@coverImage"
                                            data-news-title="@title">
                                        <img data-news-reader-image-src="@coverImage" alt="@title" onerror="this.closest('.launcher-news-reader-banner')?.remove();" />
                                    </button>
                                }
                                else if (videoPlatforms.Count > 0)
                                {
                                    <div class="launcher-news-reader-video" data-news-video-player>
                                        <iframe data-news-reader-video-src="@videoUrl"
                                                data-news-video-frame
                                                frameborder="0"
                                                allow="clipboard-write; autoplay; encrypted-media; picture-in-picture"
                                                allowfullscreen
                                                webkitallowfullscreen
                                                mozallowfullscreen>
                                        </iframe>
                                        @if (videoPlatforms.Count > 1)
                                        {
                                            <div class="launcher-news-video-links compact in-player" aria-label="@videoPlatformsLabel">
                                                @foreach (var platform in videoPlatforms)
                                                {
                                                    <button type="button"
                                                            class="@(platform.Key == videoPlatforms[0].Key ? "active" : string.Empty)"
                                                            data-news-video-platform="@platform.Key"
                                                            data-news-video-src="@platform.EmbedUrl"
                                                            title="@platform.Name">
                                                        <img src="@platform.IconUrl" alt="@platform.Name" />
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </header>

                            <div class="launcher-news-reader-body">
                                @if (!string.IsNullOrWhiteSpace(markdown))
                                {
                                    <div class="launcher-news-reader-markdown">
                                        @Html.Raw(MarkdownHtmlHelper.ToSafeHtml(markdown, true))
                                    </div>
                                }

                                @if (galleryImages.Count > 0)
                                {
                                    <div class="launcher-news-reader-gallery">
                                        @foreach (var image in galleryImages)
                                        {
                                            <button type="button" data-news-lightbox="@image" data-news-title="@title">
                                                <img data-news-reader-image-src="@image" alt="@title" onerror="this.closest('button')?.remove();" />
                                            </button>
                                        }
                                    </div>
                                }

                                @if (videoPlatforms.Count > 0 && !string.IsNullOrWhiteSpace(coverImage))
                                {
                                    <div class="launcher-news-reader-video" data-news-video-player>
                                        <iframe data-news-reader-video-src="@videoUrl"
                                                data-news-video-frame
                                                frameborder="0"
                                                allow="clipboard-write; autoplay; encrypted-media; picture-in-picture"
                                                allowfullscreen
                                                webkitallowfullscreen
                                                mozallowfullscreen>
                                        </iframe>
                                        @if (videoPlatforms.Count > 1)
                                        {
                                            <div class="launcher-news-video-links compact in-player" aria-label="@videoPlatformsLabel">
                                                @foreach (var platform in videoPlatforms)
                                                {
                                                    <button type="button"
                                                            class="@(platform.Key == videoPlatforms[0].Key ? "active" : string.Empty)"
                                                            data-news-video-platform="@platform.Key"
                                                            data-news-video-src="@platform.EmbedUrl"
                                                            title="@platform.Name">
                                                        <img src="@platform.IconUrl" alt="@platform.Name" />
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                <footer class="launcher-news-reader-actions">
                                    <button class="launcher-news-like-box launcher-news-like-button"
                                            type="button"
                                            data-news-like="@news.Id"
                                            aria-label="@likeLabel">
                                        <span class="launcher-news-like-icon" aria-hidden="true"></span>
                                        <strong data-news-like-count>@Math.Max(0, news.LikeCount)</strong>
                                    </button>
                                    <button class="launcher-news-action-button"
                                            type="button"
                                            data-news-reader-share="@news.Id"
                                            data-news-reader-share-url="@canonicalNewsPath"
                                            data-share-label="@shareLabel"
                                            data-share-copied-label="@shareCopiedLabel">
                                        @shareLabel
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(news.GithubUrl))
                                    {
                                        <a class="launcher-news-github" href="@news.GithubUrl" target="_blank" rel="noopener noreferrer">
                                            <img src="/img/github-mark.svg" alt="" aria-hidden="true" />
                                            <span>@PickText(news.GithubProjectName, "GitHub")</span>
                                        </a>
                                    }
                                </footer>
                            </div>
                        </article>
                    }
                </div>
                <div class="launcher-news-reader-rail" aria-label="@newsNavigationLabel">
                    <button type="button" class="launcher-news-reader-close" data-news-reader-close aria-label="@closeLabel">&times;</button>
                    <button type="button" data-news-reader-previous aria-label="@newerLabel">&#9650;</button>
                    <button type="button" data-news-reader-next aria-label="@olderLabel">&#9660;</button>
                    <img src="/img/Main.webp" alt="" aria-hidden="true" />
                </div>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="launcher-news-pagination">
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <a class="@(i == Model.CurrentPage ? "active" : string.Empty)"
                           href="@Url.Action("Launcher", "Home", new { search = Model.Search, order = orderFilter, platform = platformFilter, type = typeFilter, github = Model.GithubFilter, page = i })">
                            @i
                        </a>
                    }
                </nav>
            }
        </div>
    </section>
</article>
<script>
    (() => {
        const dialog = document.querySelector('[data-launcher-filter-dialog]');
        const openButton = document.querySelector('[data-launcher-filter-open]');
        const closeButton = document.querySelector('[data-launcher-filter-close]');

        if (!dialog || !openButton) {
            return;
        }

        openButton.addEventListener('click', () => {
            if (typeof dialog.showModal === 'function') {
                dialog.showModal();
            }
        });

        if (new URLSearchParams(window.location.search).get('filter') === 'open'
            && typeof dialog.showModal === 'function') {
            window.setTimeout(() => dialog.showModal(), 120);
        }

        closeButton?.addEventListener('click', () => dialog.close());

        dialog.addEventListener('click', (event) => {
            if (event.target === dialog) {
                dialog.close();
            }
        });
    })();
</script>
