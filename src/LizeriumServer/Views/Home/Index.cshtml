@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Index_title_site"];
}
<article class="lizerium-home">
    <section class="lizerium-hero" aria-labelledby="lizerium-hero-title">
        <div class="lizerium-hero-content">
            <div class="lizerium-kicker">
                <img src="~/favicon.ico" alt="" aria-hidden="true" />
                <span>@Localizer["Index_Hero_Kicker"]</span>
            </div>
            <h1 id="lizerium-hero-title">@Localizer["Index_Hero_Title_Line1"]<br />@Localizer["Index_Hero_Title_Line2"]</h1>
            <p>@Localizer["Index_Hero_Subtitle"]</p>
            <div class="lizerium-hero-actions">
                <a class="lizerium-primary-button custom-cursor-hover" href="/Home/Game">@Localizer["Index_Hero_Primary"] <span>→</span></a>
                <a class="lizerium-secondary-button custom-cursor-hover" href="/Home/Launcher">@Localizer["Index_Hero_Secondary"] <span class="lizerium-news-button-icon" aria-hidden="true"></span></a>
            </div>
        </div>
    </section>

    <section class="lizerium-feature-grid" aria-label="@Localizer["Index_title"]">
        <a class="lizerium-feature-card accent-purple custom-cursor-hover" href="/Home/Launcher">
            <span class="lizerium-card-icon"><span class="nav-icon nav-icon-news" aria-hidden="true"></span></span>
            <strong>@Localizer["Index_News"]</strong>
            <span>@Localizer["Index_News_Description"]</span>
            <em>@Localizer["Index_News_Action"] →</em>
        </a>
        <a class="lizerium-feature-card accent-blue custom-cursor-hover" href="/Home/Game">
            <span class="lizerium-card-icon"><span class="nav-icon nav-icon-games" aria-hidden="true"></span></span>
            <strong>@Localizer["Index_Games_Feature_Title"]</strong>
            <span>@Localizer["Index_Games_Description"]</span>
            <em>@Localizer["Index_Games_Action"] →</em>
        </a>
        <a class="lizerium-feature-card accent-green custom-cursor-hover" href="/docs/all">
            <span class="lizerium-card-icon"><span class="nav-icon nav-icon-knowledge" aria-hidden="true"></span></span>
            <strong>@Localizer["Index_Info"]</strong>
            <span>@Localizer["Index_Info_Description"]</span>
            <em>@Localizer["Index_Info_Action"] →</em>
        </a>
    </section>

    <section class="lizerium-section">
        <div class="lizerium-section-heading">
            <span></span>
            <h2>@Localizer["Index_Ecosystem_Title"]</h2>
            <span></span>
        </div>
        <div class="lizerium-ecosystem-grid">
            <a class="lizerium-mini-card ecosystem-projects custom-cursor-hover" href="/Home/Game#projects">
                <span class="lizerium-mini-icon"><img src="~/img/pages/home/ecosystem-projects.webp" alt="" aria-hidden="true" /></span>
                <strong>@Localizer["Index_Ecosystem_Projects_Title"]</strong>
                <small>@Localizer["Index_Ecosystem_Projects_Description"]</small>
                <em>→</em>
            </a>
            <a class="lizerium-mini-card ecosystem-tools custom-cursor-hover" href="/Home/Game#tools">
                <span class="lizerium-mini-icon"><img src="~/img/pages/home/ecosystem-tools.webp" alt="" aria-hidden="true" /></span>
                <strong>@Localizer["Index_Ecosystem_Tools_Title"]</strong>
                <small>@Localizer["Index_Ecosystem_Tools_Description"]</small>
                <em>→</em>
            </a>
            <a class="lizerium-mini-card ecosystem-launcher custom-cursor-hover" href="/Home/Game#launcher">
                <span class="lizerium-mini-icon"><img src="~/img/pages/home/ecosystem-launcher.webp" alt="" aria-hidden="true" /></span>
                <strong>@Localizer["Index_Ecosystem_Launcher_Title"]</strong>
                <small>@Localizer["Index_Ecosystem_Launcher_Description"]</small>
                <em>→</em>
            </a>
            <a class="lizerium-mini-card ecosystem-docs custom-cursor-hover" href="/wiki">
                <span class="lizerium-mini-icon"><img src="~/img/nav/knowledge.webp" alt="" aria-hidden="true" /></span>
                <strong>@Localizer["Index_Ecosystem_Docs_Title"]</strong>
                <small>@Localizer["Index_Ecosystem_Docs_Description"]</small>
                <em>→</em>
            </a>
            <button class="lizerium-mini-card ecosystem-server custom-cursor-hover" type="button" onclick="document.getElementById('server-solutions-dialog').showModal()">
                <span class="lizerium-mini-icon"><img src="~/img/pages/home/ecosystem-server.webp" alt="" aria-hidden="true" /></span>
                <strong>@Localizer["Index_Ecosystem_Server_Title"]</strong>
                <small>@Localizer["Index_Ecosystem_Server_Description"]</small>
                <em>→</em>
            </button>
            <a class="lizerium-mini-card ecosystem-community custom-cursor-hover" href="/Home/Community">
                <span class="lizerium-mini-icon"><img src="~/img/nav/community.webp" alt="" aria-hidden="true" /></span>
                <strong>@Localizer["Index_Ecosystem_Community_Title"]</strong>
                <small>@Localizer["Index_Ecosystem_Community_Description"]</small>
                <em>→</em>
            </a>
            <a class="lizerium-mini-card ecosystem-support custom-cursor-hover" href="/Home/Wish">
                <span class="lizerium-mini-icon"><img src="~/img/nav/support.webp" alt="" aria-hidden="true" /></span>
                <strong>@Localizer["Index_Ecosystem_Support_Title"]</strong>
                <small>@Localizer["Index_Ecosystem_Support_Description"]</small>
                <em>→</em>
            </a>
        </div>
    </section>

    <dialog id="server-solutions-dialog" class="lizerium-dialog">
        <form method="dialog">
            <button class="lizerium-dialog-close custom-cursor-hover" value="close" aria-label="@Localizer["Index_Dialog_Close"]">×</button>
        </form>
        <div class="lizerium-dialog-header">
            <span class="lizerium-mini-icon"><img src="~/img/pages/home/ecosystem-server.webp" alt="" aria-hidden="true" /></span>
            <div>
                <h3>@Localizer["Index_Ecosystem_Server_Title"]</h3>
                <p>@Localizer["Index_Server_Dialog_Description"]</p>
            </div>
        </div>
        <div class="lizerium-dialog-links">
            <a class="custom-cursor-hover" href="/docs/hook">
                <strong>@Localizer["Index_Server_Dialog_Hook_Title"]</strong>
                <span>@Localizer["Index_Server_Dialog_Hook_Description"]</span>
            </a>
            <a class="custom-cursor-hover" href="/docs/builds">
                <strong>@Localizer["Index_Server_Dialog_Builds_Title"]</strong>
                <span>@Localizer["Index_Server_Dialog_Builds_Description"]</span>
            </a>
        </div>
    </dialog>

    <section class="lizerium-section lizerium-links-section">
        <div class="lizerium-section-heading">
            <span></span>
            <h2>@Localizer["Index_Links_Title"]</h2>
            <span></span>
        </div>
        <div class="lizerium-link-grid">
            <a class="lizerium-link-card link-discovery custom-cursor-hover" href="https://discoverygc.com/" target="_blank" rel="noopener noreferrer"><span>📀</span><strong>Freelancer Discovery</strong><small>@Localizer["Index_Link_Discovery_Description"]</small><em>→</em></a>
            <a class="lizerium-link-card link-sirius custom-cursor-hover" href="https://fl-sr.eu/" target="_blank" rel="noopener noreferrer"><span>💎</span><strong>Freelancer Sirius Revival</strong><small>@Localizer["Index_Link_Sirius_Description"]</small><em>→</em></a>
            <a class="lizerium-link-card link-nomad custom-cursor-hover" href="https://freelancer2.space/en/" target="_blank" rel="noopener noreferrer"><span>🎆</span><strong>Freelancer Nomad Legacy</strong><small>@Localizer["Index_Link_Nomad_Description"]</small><em>→</em></a>
            <a class="lizerium-link-card link-crossfire custom-cursor-hover" href="https://swat-portal.com/forum/cms/wiki/crossfire/" target="_blank" rel="noopener noreferrer"><span>💥</span><strong>Freelancer Crossfire 2.0</strong><small>@Localizer["Index_Link_Crossfire_Description"]</small><em>→</em></a>
            <a class="lizerium-link-card link-hd custom-cursor-hover" href="https://www.moddb.com/mods/freelancer-hd-edition" target="_blank" rel="noopener noreferrer"><span>🔅</span><strong>Freelancer HD Edition</strong><small>@Localizer["Index_Link_Hd_Description"]</small><em>→</em></a>
            <a class="lizerium-link-card link-rebirth custom-cursor-hover" href="https://freelancerothe.ucoz.ru/" target="_blank" rel="noopener noreferrer"><span>💫</span><strong>Freelancer Rebirth</strong><small>@Localizer["Index_Link_Rebirth_Description"]</small><em>→</em></a>
            <a class="lizerium-link-card link-orion custom-cursor-hover" href="http://fl-orion.ucoz.ru/" target="_blank" rel="noopener noreferrer"><span>🌏</span><strong>Freelancer Orion</strong><small>@Localizer["Index_Link_Orion_Description"]</small><em>→</em></a>
        </div>
    </section>
</article>
