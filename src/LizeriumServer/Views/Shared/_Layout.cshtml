            <form id="cultureForm" method="post" asp-controller="Culture" asp-action="SetLanguage">
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <select name="culture" onchange="document.getElementById('cultureForm').submit()" class="form-select">
                    <option value="ru" selected="@((CultureInfo.CurrentUICulture.Name == "ru") ? "selected" : null)">Русский</option>
                    <option value="en" selected="@((CultureInfo.CurrentUICulture.Name == "en") ? "selected" : null)">English</option>
                </select>
            </form>
        </div>
        <hr />
        <div class="lizerium-sidebar">
            <div class="lizerium-logo" title="Главная" onclick="window.location.href='/'">
                <img src="@Url.Content("~/img/Main.png")" alt="Lizerium">
            </div>
            <div class="lizerium-menu-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")" title="Главная" onclick="window.location.href='@Url.Action("Index", "Home")'">
                🔮
            </div>
            <div class="lizerium-menu-item @(currentController == "Home" && currentAction == "Launcher" ? "active" : "")" title="Новости" onclick="window.location.href='@Url.Action("Launcher", "Home")'">
                📰
            </div>
            <div class="lizerium-menu-item @(currentController == "Home" && currentAction == "Game" ? "active" : "")" title="Игры" onclick="window.location.href='@Url.Action("Game", "Home")'">
                🎮
            </div>
            <div class="lizerium-menu-item @(currentController == "Documents" ? "active" : "")" title="Знания" onclick="window.location.href='@Url.Action("all", "docs")'">
                ⚙️
            </div>
            @* <div class="lizerium-menu-item @(currentController == "Forum" && currentAction == "ForumMain" ? "active" : "")" title="Форум" onclick="window.location.href='@Url.Action("ForumMain", "Forum")'"> *@
@*                 💬
            </div> *@
            <div class="lizerium-menu-item @(currentController == "Home" && currentAction == "Wish" ? "active" : "")" title="Пожелания пользователей" onclick="window.location.href='@Url.Action("Wish", "Home")'">
                ❓
            </div>
        </div>
        <div class="mobile-nav">
            <div class="mobile-nav-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")" title="Главная" onclick="window.location.href='@Url.Action("Index", "Home")'">
                🔮
            </div>
            <div class="mobile-nav-item @(currentController == "Home" && currentAction == "Launcher" ? "active" : "")" title="Новости" onclick="window.location.href='@Url.Action("Launcher", "Home")'">
                📰
