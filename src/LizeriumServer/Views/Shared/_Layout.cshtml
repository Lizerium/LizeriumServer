                <span class="nav-icon nav-icon-games" aria-hidden="true"></span>
            </div>
            <div class="lizerium-menu-item @(isKnowledgeSection ? "active" : "")" title="@SharedLocalizer["Shared_Nav_Knowledge"]" data-transition-href="/docs/all">
                <span class="nav-icon nav-icon-knowledge" aria-hidden="true"></span>
            </div>
            <div class="lizerium-menu-item @(currentController == "Home" && currentAction == "Community" ? "active" : "")" title="@SharedLocalizer["Shared_Nav_Community"]" data-transition-href="@Url.Action("Community", "Home")">
                <span class="nav-icon nav-icon-community" aria-hidden="true"></span>
            </div>
            <div class="lizerium-menu-item @(currentController == "Home" && currentAction == "Wish" ? "active" : "")" title="@SharedLocalizer["Shared_Nav_Support"]" data-transition-href="@Url.Action("Wish", "Home")">
                <span class="nav-icon nav-icon-support" aria-hidden="true"></span>
            </div>
        </div>
        <div class="mobile-nav">
            <div class="mobile-nav-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")" title="@SharedLocalizer["Shared_Nav_Home"]" data-transition-href="@Url.Action("Index", "Home")">
                <span class="nav-icon nav-icon-home" aria-hidden="true"></span>
            </div>
            <div class="mobile-nav-item @(currentController == "Home" && currentAction == "Launcher" ? "active" : "")" title="@SharedLocalizer["Shared_Nav_News"]" data-transition-href="@Url.Action("Launcher", "Home")">
                <span class="nav-icon nav-icon-news" aria-hidden="true"></span>
            </div>
            <div class="mobile-nav-item @(currentController == "Home" && currentAction == "Game" ? "active" : "")" title="@SharedLocalizer["Shared_Nav_Games"]" data-transition-href="@Url.Action("Game", "Home")">
                <span class="nav-icon nav-icon-games" aria-hidden="true"></span>
            </div>
            <div class="mobile-nav-item @(isKnowledgeSection ? "active" : "")" title="@SharedLocalizer["Shared_Nav_Knowledge"]" data-transition-href="/docs/all">
                <span class="nav-icon nav-icon-knowledge" aria-hidden="true"></span>
            </div>
            <div class="mobile-nav-item @(currentController == "Home" && currentAction == "Community" ? "active" : "")" title="@SharedLocalizer["Shared_Nav_Community"]" data-transition-href="@Url.Action("Community", "Home")">
                <span class="nav-icon nav-icon-community" aria-hidden="true"></span>
            </div>
            <div class="mobile-nav-item @(currentController == "Home" && currentAction == "Wish" ? "active" : "")" title="@SharedLocalizer["Shared_Nav_Support"]" data-transition-href="@Url.Action("Wish", "Home")">
                <span class="nav-icon nav-icon-support" aria-hidden="true"></span>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			@if(breadcrumbs.Count > 1)
			{
				@for (int i = 0; i < breadcrumbs.Count; i++)
				{
					var b = breadcrumbs[i];
					var isLast = i == breadcrumbs.Count - 1;
					<li class="breadcrumb-item @(isLast ? "active" : "")" @(isLast ? "aria-current=\"page\"" : "")>
						@if (isLast)
						{
							@b.Name
						}
						else
						{
							<a href="@b.Url">@b.Name</a>
						}
					</li>
				}
			}
		</ol>
	</nav>
    <footer>
        <div class="footer-brand">
            <span>@SharedLocalizer["Shared_Footer_Copyright"]</span>
            <small>@SharedLocalizer["Shared_Footer_Tagline"]</small>
        </div>
        <div class="footer-socials">
            <a class="footer-social footer-social-vk custom-cursor-hover" href="https://vk.com/lizerium_game" target="_blank" rel="noopener noreferrer" aria-label="@SharedLocalizer["Shared_Social_Vk"]"><span aria-hidden="true"></span></a>
            <a class="footer-social footer-social-discord custom-cursor-hover" href="https://discord.gg/sMnhKeEk8K" target="_blank" rel="noopener noreferrer" aria-label="@SharedLocalizer["Shared_Social_Discord"]"><span aria-hidden="true"></span></a>
            <a class="footer-social footer-social-brand custom-cursor-hover" href="https://dvurechensky.pro" target="_blank" rel="noopener noreferrer" aria-label="@SharedLocalizer["Shared_Social_Brand"]"><span aria-hidden="true"></span></a>
            <a class="footer-social footer-social-youtube custom-cursor-hover" href="https://www.youtube.com/@@lizerium_game" target="_blank" rel="noopener noreferrer" aria-label="@SharedLocalizer["Shared_Social_Youtube"]"><span aria-hidden="true"></span></a>
            <a class="footer-social footer-social-rutube custom-cursor-hover" href="https://rutube.ru/channel/44085490/" target="_blank" rel="noopener noreferrer" aria-label="@SharedLocalizer["Shared_Social_Rutube"]"><span aria-hidden="true"></span></a>
        </div>
    </footer>
    <div class="server-version-badge" aria-label="@SharedLocalizer["Shared_Footer_Version"] v@(ServerVersionProvider.Version)">
        <span>@SharedLocalizer["Shared_Footer_Version"]</span>
        <strong>v@(ServerVersionProvider.Version)</strong>
        <i aria-hidden="true"></i>
    </div>
