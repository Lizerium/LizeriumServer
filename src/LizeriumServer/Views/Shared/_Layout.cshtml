@inject IBreadcrumbService BreadcrumbService
@inject IViewLocalizer Localizer
@inject LizeriumServer.Helpers.ServerVersionProvider ServerVersionProvider
@inject Microsoft.Extensions.Options.IOptions<LizeriumServer.Options.SeoDomainsOptions> SeoDomainsOptions
@{
	var breadcrumbs = BreadcrumbService.GetBreadcrumbs(ViewContext.RouteData, Localizer, ViewData);
}

@using System.Globalization
@using LizeriumServer.FormatsData.AppSeo
@using System.Security.Policy
@using LizeriumServer.Services.Breadcrumb
@using LizeriumServer.Services.Breadcrumb.Implements
@{
	var seoDomains = SeoDomainsOptions.Value;
	var currentBaseUrl = seoDomains.GetBaseUrl(Context.Request);
	// Ссылка на текущую страницу
	var currentUrl = currentBaseUrl + Context.Request.Path;
	var openGraphImageUrl = seoDomains.GetOpenGraphImageUrl(Context.Request);

	// анонимный объект с "безопасными" именами
	var jsonLdObj = new
	{
		context = "https://schema.org",
		type = "BreadcrumbList",
		itemListElement = breadcrumbs.Select((b, i) => new
		{
			type = "ListItem",
			position = i + 1,
			name = b.Name,
			item = currentBaseUrl + b.Url
		}).ToList()
	};

	// сериализация и замена ключей на корректные @type, @context
	var jsonLdString = System.Text.Json.JsonSerializer.Serialize(jsonLdObj, new System.Text.Json.JsonSerializerOptions
	{
		WriteIndented = true,
		PropertyNamingPolicy = null
	})
	.Replace("\"context\"", "\"@context\"")
	.Replace("\"type\"", "\"@type\"");

	string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
	string currentAction = ViewContext.RouteData.Values["action"]?.ToString();
	string currentCulture = CultureInfo.CurrentUICulture.Name == "en" ? "en" : "ru";
	string currentCultureLabel = currentCulture == "en" ? "English" : "Русский";
	bool isHomeIndex = currentController == "Home" && currentAction == "Index";
	bool isHomeOrLauncher = currentController == "Home" && (currentAction == "Index" || currentAction == "Launcher");
	bool isKnowledgeSection = currentController == "Documents" || currentController == "Knowledge";
}

