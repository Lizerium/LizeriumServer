            <div class="mobile-nav-item @(currentController == "Home" && currentAction == "Game" ? "active" : "")" title="Игры" onclick="window.location.href='@Url.Action("Game", "Home")'">
                🎮
            </div>
            <div class="mobile-nav-item @(currentController == "Documents" ? "active" : "")" title="Знания" onclick="window.location.href='@Url.Action("all", "docs")'">
                ⚙️
            </div>
@*             <div class="mobile-nav-item @(currentController == "Forum" && currentAction == "ForumMain" ? "active" : "")" title="Форум" onclick="window.location.href='@Url.Action("ForumMain", "Forum")'">
                💬
            </div> *@
            <div class="mobile-nav-item @(currentController == "Home" && currentAction == "Wish" ? "active" : "")" title="Пожелания пользователей" onclick="window.location.href='@Url.Action("Wish", "Home")'">
                ❓
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			@if(breadcrumbs.Count > 1)
			{
				@for (int i = 0; i < breadcrumbs.Count; i++)
				{
					var b = breadcrumbs[i];
					var isLast = i == breadcrumbs.Count - 1;
					<li class="breadcrumb-item @(isLast ? "active" : "")" @(isLast ? "aria-current=\"page\"" : "")>
						@if (isLast)
						{
							@b.Name
						}
						else
						{
							<a href="@b.Url">@b.Name</a>
						}
					</li>
				}
			}
		</ol>
	</nav>
    <footer>
        <img id="vk-link custom-cursor-hover" width="20px" height="20px" src="~/img/VK.svg.png" onclick="window.open('https://vk.com/lizerium_game', '_blank', 'noopener,noreferrer')" />
        <img id="git-link custom-cursor-hover" width="20px" height="20px" src="~/img/git.png" onclick="window.open('https://github.com/Lizerium', '_blank', 'noopener,noreferrer')" />
        <img id="me-link custom-cursor-hover" width="20px" height="20px" src="~/img/my.png" onclick="window.open('https://dvurechensky.pro', '_blank', 'noopener,noreferrer')" />
    </footer>
    <div class="server-version-badge" aria-label="@versionPrefix #@ServerVersionProvider.Version">
