    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function () {
            const root = document.documentElement;
            let finished = false;

            function finishPageLoad() {
                if (finished) {
                    return;
                }

                finished = true;
                root.classList.remove('is-loading');
                root.classList.add('is-ready');
            }

            function onReady(callback) {
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', callback, { once: true });
                    return;
                }

                callback();
            }

            onReady(function () {
                const isHomeIndex = @(isHomeIndex ? "true" : "false");

                if (!isHomeIndex) {
                    requestAnimationFrame(finishPageLoad);
                    return;
                }

                const hero = new Image();
                const timeout = window.setTimeout(finishPageLoad, 1200);

                hero.decoding = 'async';
                hero.src = '@Url.Content("~/img/pages/home/lizerium-hero-space.webp")';

                const complete = function () {
                    window.clearTimeout(timeout);
                    requestAnimationFrame(finishPageLoad);
                };

                if (hero.decode) {
                    hero.decode().then(complete).catch(complete);
                    return;
                }

                hero.onload = complete;
                hero.onerror = complete;
            });
        })();
    </script>
    <script>
        (function () {
            const combo = document.querySelector('[data-language-combobox]');
            const form = document.getElementById('cultureForm');
            const input = document.getElementById('cultureInput');

            if (!combo || !form || !input) {
                return;
            }

            const trigger = combo.querySelector('.language-combobox-button');
            const options = combo.querySelectorAll('.language-option');

            function closeCombo() {
                combo.classList.remove('open');
                trigger.setAttribute('aria-expanded', 'false');
            }

            trigger.addEventListener('click', function () {
                const isOpen = combo.classList.toggle('open');
                trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });

            options.forEach(function (option) {
                option.addEventListener('click', function () {
                    const culture = option.getAttribute('data-culture');
                    if (culture && culture !== input.value) {
                        input.value = culture;
                        form.submit();
                        return;
                    }

                    closeCombo();
                });
            });

            document.addEventListener('click', function (event) {
                if (!combo.contains(event.target)) {
                    closeCombo();
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeCombo();
                }
            });
        })();
    </script>
    <script>
        (function () {
            const root = document.documentElement;
            let isNavigating = false;

            function getNavigationUrl(trigger) {
                if (!trigger) {
                    return null;
                }

                if (trigger.hasAttribute('data-transition-href')) {
                    return trigger.getAttribute('data-transition-href');
                }

                return trigger.getAttribute('href');
            }

            function normalizeRoutePath(pathname) {
                const normalized = pathname.toLowerCase().replace(/\/+$/, '') || '/';

                if (normalized === '/home' || normalized === '/home/index') {
                    return '/';
                }

                return normalized;
            }

            function canUseTransition(event, trigger, url) {
                if (!url || isNavigating) {
                    return false;
                }

                if (trigger.closest('.active')) {
                    return false;
                }

                if (event.type === 'click' && (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)) {
                    return false;
                }

                if (trigger.matches('a[target="_blank"], a[download]')) {
                    return false;
                }

                let targetUrl;

                try {
                    targetUrl = new URL(url, window.location.href);
                } catch {
                    return false;
                }

                if (targetUrl.origin !== window.location.origin) {
                    return false;
                }

                const currentPath = window.location.pathname + window.location.search;
                const targetPath = targetUrl.pathname + targetUrl.search;
                const currentRoute = normalizeRoutePath(window.location.pathname);
                const targetRoute = normalizeRoutePath(targetUrl.pathname);

                if (currentPath === targetPath && targetUrl.hash) {
                    return false;
                }

                if (window.location.href === targetUrl.href || (currentRoute === targetRoute && window.location.search === targetUrl.search)) {
                    return false;
                }

                return true;
            }

            function startTransition(url) {
                isNavigating = true;
                root.classList.add('is-page-transitioning');
                window.setTimeout(function () {
                    window.location.href = url;
                }, 280);
            }

            document.addEventListener('click', function (event) {
                const trigger = event.target.closest('a[href], [data-transition-href]');
                const url = getNavigationUrl(trigger);

                if (!canUseTransition(event, trigger, url)) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                startTransition(new URL(url, window.location.href).href);
            }, true);

            document.addEventListener('keydown', function (event) {
                if (event.key !== 'Enter' && event.key !== ' ') {
                    return;
                }

                const trigger = event.target.closest('[data-transition-href]');
                const url = getNavigationUrl(trigger);

                if (!canUseTransition(event, trigger, url)) {
                    return;
                }

                event.preventDefault();
                startTransition(new URL(url, window.location.href).href);
            });

            document.querySelectorAll('[data-transition-href]').forEach(function (item) {
                item.setAttribute('role', 'link');
                item.setAttribute('tabindex', '0');
            });

            window.addEventListener('pageshow', function () {
                isNavigating = false;
                root.classList.remove('is-page-transitioning');
            });
        })();
    </script>
