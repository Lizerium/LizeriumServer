            </span>
            <strong>@SharedLocalizer["Shared_PageTransition_Title"]</strong>
            <small>@SharedLocalizer["Shared_PageTransition_Subtitle"]</small>
        </div>
    </div>
    <div class="position-fixed pointer-eveb bottom-0 end-0 m-4 p-4" style="z-index: 1100; pointer-events: none;">
        <div id="copyToast" class="toast align-items-center text-bg-primary border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    Скопировано!
                </div>
                <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <div id="preloader" aria-hidden="true">
        <div class="lizerium-page-transition-stars"></div>
        <div class="lizerium-page-transition-panel">
            <span class="lizerium-page-transition-mark">
                <span class="lizerium-page-transition-orbit"></span>
                <img src="~/img/Main.webp" alt="">
            </span>
            <strong>@SharedLocalizer["Shared_PageTransition_Title"]</strong>
            <small>@SharedLocalizer["Shared_PageTransition_Subtitle"]</small>
        </div>
    </div>
    <header>
        <div class="header_icon_lang_block">
            <div class="icon" data-transition-href="@Url.Action("Index", "Home")"><img src="~/img/Main.webp" alt="Вернуться" class="logo"><img src="~/img/brand/lizerium-wordmark.svg" alt="LIZERIUM" class="lizerium-wordmark"></div>
            <nav class="desktop-top-nav" aria-label="Основная навигация">
                <a class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")" href="@Url.Action("Index", "Home")">@SharedLocalizer["Shared_Nav_Home"]</a>
                <a class="@(currentController == "Home" && currentAction == "Launcher" ? "active" : "")" href="@Url.Action("Launcher", "Home")">@SharedLocalizer["Shared_Nav_News"]</a>
                <a class="@(currentController == "Home" && currentAction == "Game" ? "active" : "")" href="@Url.Action("Game", "Home")">@SharedLocalizer["Shared_Nav_Games"]</a>
                <a class="@(isKnowledgeSection ? "active" : "")" href="/docs/all">@SharedLocalizer["Shared_Nav_Knowledge"]</a>
                <a class="@(currentController == "Home" && currentAction == "Community" ? "active" : "")" href="@Url.Action("Community", "Home")">@SharedLocalizer["Shared_Nav_Community"]</a>
                <a class="@(currentController == "Home" && currentAction == "Wish" ? "active" : "")" href="@Url.Action("Wish", "Home")">@SharedLocalizer["Shared_Nav_Support"]</a>
            </nav>
            <form id="cultureForm" method="post" asp-controller="Culture" asp-action="SetLanguage">
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <input id="cultureInput" type="hidden" name="culture" value="@currentCulture" />
                <div class="language-combobox" data-language-combobox>
                    <button class="language-combobox-button custom-cursor-hover" type="button" aria-haspopup="listbox" aria-expanded="false">
                        <span class="language-globe" aria-hidden="true"></span>
                        <span class="language-current">@currentCultureLabel</span>
                        <span class="language-chevron" aria-hidden="true"></span>
                    </button>
                    <div class="language-combobox-menu" role="listbox" aria-label="Language">
                        <button class="language-option @(currentCulture == "ru" ? "active" : "")" type="button" role="option" aria-selected="@(currentCulture == "ru" ? "true" : "false")" data-culture="ru">Русский</button>
                        <button class="language-option @(currentCulture == "en" ? "active" : "")" type="button" role="option" aria-selected="@(currentCulture == "en" ? "true" : "false")" data-culture="en">English</button>
                    </div>
                </div>
            </form>
        </div>
        <hr />
        <div class="lizerium-sidebar">
            <div class="lizerium-logo" title="@SharedLocalizer["Shared_Nav_Home"]" data-transition-href="/">
                <img src="@Url.Content("~/img/Main.webp")" alt="Lizerium">
            </div>
            <div class="lizerium-menu-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")" title="@SharedLocalizer["Shared_Nav_Home"]" data-transition-href="@Url.Action("Index", "Home")">
