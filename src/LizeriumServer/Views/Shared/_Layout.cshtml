@inject IBreadcrumbService BreadcrumbService
@inject IViewLocalizer Localizer
@inject LizeriumServer.Helpers.ServerVersionProvider ServerVersionProvider
@{
	var breadcrumbs = BreadcrumbService.GetBreadcrumbs(ViewContext.RouteData, Localizer, ViewData);
}

@using System.Globalization
@using LizeriumServer.FormatsData.AppSeo
@using System.Security.Policy
@using LizeriumServer.Services.Breadcrumb
@using LizeriumServer.Services.Breadcrumb.Implements
@{
	// Ссылка на текущую страницу
	var currentUrl = Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path;

	// анонимный объект с "безопасными" именами
	var jsonLdObj = new
	{
		context = "https://schema.org",
		type = "BreadcrumbList",
		itemListElement = breadcrumbs.Select((b, i) => new
		{
			type = "ListItem",
			position = i + 1,
			name = b.Name,
			item = Context.Request.Scheme + "://" + Context.Request.Host + b.Url
		}).ToList()
	};

	// сериализация и замена ключей на корректные @type, @context
	var jsonLdString = System.Text.Json.JsonSerializer.Serialize(jsonLdObj, new System.Text.Json.JsonSerializerOptions
	{
		WriteIndented = true,
		PropertyNamingPolicy = null
	})
	.Replace("\"context\"", "\"@context\"")
	.Replace("\"type\"", "\"@type\"");
}

