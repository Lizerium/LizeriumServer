@model MainModel
@{
    ViewData["Title"] = @"Посты";
}

<div class="container top with_left_side">
    <section class="admin-workspace">
        <div class="dashboard-header">
            <div>
                <span class="dashboard-kicker">Lizerium API</span>
                <h2>Обращения пользователей</h2>
            </div>
            <div class="dashboard-status">@((Model.Posts?.Posts?.Count ?? 0)) последних</div>
        </div>

    <input type="hidden" id="last_user_id" value="@Model.Posts.LastUserId" />
    <div class="admin-toolbar">
        <label class="field-inline">
            <span>Фильтр</span>
            <select id="postsStatus">
                <option value="0">Все</option>
                <option value="1">Новое</option>
                <option value="2">Прочитано</option>
                <option value="3">В работе</option>
                <option value="4">Отказано</option>
                <option value="5">Выполнено</option>
            </select>
        </label>
    </div>

    <div class="admin-panel">
        <div class="admin-panel-header">
            <h3>Список обращений</h3>
            <span>подгрузка продолжится при прокрутке</span>
        </div>
        <div class="admin-table-wrap">
        <table class="admin-table posts-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Пользователь</th>
                    <th>Время, (МСК)</th>
                    <th>Сообщение</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var postData in Model.Posts.Posts)
                {
                    <tr>
                        <td>@postData.Id</td>
                        <td>
                            <div class="user_in_table">
                                <div>
                                    <img src="~/img/my-account-icon.png" alt="@postData.Autor" />
                                </div>
                                <div>
                                    <span>@postData.Autor</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="times">
                                <span>Регистрация</span>
                                <span>@postData.DateTimeUnixString</span>
                            </div>
                        </td>
                        <td>@postData.Message</td>
                        <td>
                            <select class="post-status-select" asp-for="@postData.Status" user="@postData.Id">
                                <option value="-1">Обработка</option>
                                <option value="1">Новое</option>
                                <option value="2">Прочитано</option>
                                <option value="3">В работе</option>
                                <option value="4">Отказано</option>
                                <option value="5">Выполнено</option>
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
    </section>
</div>
