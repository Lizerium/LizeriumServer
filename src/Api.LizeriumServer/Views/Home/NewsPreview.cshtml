@model MainModel
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.RegularExpressions
@{
    var news = Model.LauncherNews.FirstOrDefault();
    var culture = string.Equals(Model.NewsPreviewCulture, "en", StringComparison.OrdinalIgnoreCase) ? "en" : "ru";
    var isRussian = culture == "ru";
    var title = PickText(isRussian ? news?.TitleRu : news?.TitleEn, isRussian ? news?.TitleEn : news?.TitleRu);
    var markdown = PickText(isRussian ? news?.MarkdownRu : news?.MarkdownEn, isRussian ? news?.MarkdownEn : news?.MarkdownRu);
    var newsType = PickText(isRussian ? news?.NewsTypeRu : news?.NewsTypeEn, PickText(news?.NewsType, isRussian ? news?.NewsTypeEn : news?.NewsTypeRu));
    var publishedAt = news?.PublishedAtUnix > 0
        ? DateTimeOffset.FromUnixTimeSeconds(news.PublishedAtUnix).ToLocalTime().ToString("dd.MM.yyyy HH:mm")
        : "без даты";
    var coverUrl = GetNewsPreviewUrl(news?.ImageUrl);
    var iconUrl = GetNewsPreviewUrl(news?.IconUrl);
    var rawGalleryUrls = GetGalleryImageUrls(news?.ImageGalleryJson);
    var videoPlatforms = GetVideoPlatforms(news, isRussian);
    var videoPosterUrl = videoPlatforms.FirstOrDefault(platform => !string.IsNullOrWhiteSpace(platform.PosterUrl))?.PosterUrl ?? string.Empty;
    var firstGalleryImageUrl = GetFirstGalleryImageUrl(news?.ImageGalleryJson);
    var firstMarkdownImageUrl = GetMarkdownImages(markdown).FirstOrDefault() ?? string.Empty;
    var cardImageRawUrl = PickText(news?.ImageUrl, PickText(firstGalleryImageUrl, firstMarkdownImageUrl));
    var cardImageUrl = PickText(GetNewsPreviewUrl(cardImageRawUrl), videoPosterUrl);
    var cardImageFallbackUrl = GetPublicImageFallbackUrl(cardImageRawUrl);
    var hasCardImage = !string.IsNullOrWhiteSpace(cardImageUrl);
    var cardHtml = BuildNewsCardHtml(markdown, title);
    ViewData["Title"] = $"Предпросмотр: {title}";
}
@functions {
    private sealed class NewsVideoPlatform
    {
        public string Key { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public string Url { get; init; } = string.Empty;
        public string EmbedUrl { get; init; } = string.Empty;
        public string PosterUrl { get; init; } = string.Empty;
    }

    private static string PickText(string primary, string fallback)
    {
        return !string.IsNullOrWhiteSpace(primary) ? primary : fallback ?? string.Empty;
    }

    private static string GetNewsPreviewUrl(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
            return string.Empty;

        if (Uri.TryCreate(imageUrl, UriKind.Absolute, out _))
            return imageUrl;

        if (!imageUrl.StartsWith("/img/news/", StringComparison.OrdinalIgnoreCase))
            return imageUrl;

        return $"/news/assets/preview?url={Uri.EscapeDataString(imageUrl)}";
    }

    private static string GetPublicImageFallbackUrl(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl) || Uri.TryCreate(imageUrl, UriKind.Absolute, out _))
            return string.Empty;

        return imageUrl.StartsWith("/img/news/", StringComparison.OrdinalIgnoreCase)
            ? $"https://lizup.ru{imageUrl}"
            : string.Empty;
    }

    private static IReadOnlyList<string> GetGalleryPreviewUrls(string imageGalleryJson)
    {
        if (string.IsNullOrWhiteSpace(imageGalleryJson))
            return Array.Empty<string>();

        try
        {
            return JsonSerializer.Deserialize<List<string>>(imageGalleryJson)?
                .Where(url => !string.IsNullOrWhiteSpace(url))
                .Select(GetNewsPreviewUrl)
                .ToList() ?? new List<string>();
        }
        catch
        {
            return imageGalleryJson
                .Split(new[] { "\r\n", "\n", ";", "," }, StringSplitOptions.RemoveEmptyEntries)
                .Select(url => url.Trim())
                .Where(url => !string.IsNullOrWhiteSpace(url))
                .Select(GetNewsPreviewUrl)
                .ToList();
        }
    }

    private static IReadOnlyList<string> GetGalleryImageUrls(string imageGalleryJson)
    {
        if (string.IsNullOrWhiteSpace(imageGalleryJson))
            return Array.Empty<string>();

        try
        {
            return JsonSerializer.Deserialize<List<string>>(imageGalleryJson)?
                .Where(url => !string.IsNullOrWhiteSpace(url))
                .Select(url => url.Trim())
                .ToList() ?? new List<string>();
        }
        catch
        {
            return imageGalleryJson
                .Split(new[] { "\r\n", "\n", ";", "," }, StringSplitOptions.RemoveEmptyEntries)
                .Select(url => url.Trim())
                .Where(url => !string.IsNullOrWhiteSpace(url))
                .ToList();
        }
    }

    private static string GetFirstGalleryImageUrl(string imageGalleryJson)
    {
        if (string.IsNullOrWhiteSpace(imageGalleryJson))
            return string.Empty;

        try
        {
            return JsonSerializer.Deserialize<List<string>>(imageGalleryJson)?
                .FirstOrDefault(url => !string.IsNullOrWhiteSpace(url)) ?? string.Empty;
        }
        catch
        {
            return imageGalleryJson
                .Split(new[] { "\r\n", "\n", ";", "," }, StringSplitOptions.RemoveEmptyEntries)
                .Select(url => url.Trim())
                .FirstOrDefault(url => !string.IsNullOrWhiteSpace(url)) ?? string.Empty;
        }
    }

    private static List<NewsVideoPlatform> GetVideoPlatforms(LizeriumUtilities.FormatsData.DataBase.Response.LauncherNewsDataResponse news, bool isRussian)
    {
        var platforms = new List<NewsVideoPlatform>();
        if (news == null)
            return platforms;

        AddVideo(platforms, "youtube", "YouTube", news.YoutubeUrl, BuildYoutubeEmbedUrl(news.YoutubeUrl), BuildYoutubePosterUrl(news.YoutubeUrl));
        AddVideo(platforms, "vk", "VK", news.VkVideoUrl, BuildVkEmbedUrl(news.VkVideoUrl), string.Empty);
        AddVideo(platforms, "rutube", "Rutube", news.RutubeUrl, BuildRutubeEmbedUrl(news.RutubeUrl), BuildRutubePosterUrl(news.RutubeUrl));

        var order = isRussian
            ? new[] { "rutube", "vk", "youtube" }
            : new[] { "youtube", "vk", "rutube" };

        return platforms
            .OrderBy(platform =>
            {
                var index = Array.IndexOf(order, platform.Key);
                return index < 0 ? order.Length : index;
            })
            .ToList();
    }

    private static void AddVideo(List<NewsVideoPlatform> platforms, string key, string name, string url, string embedUrl, string posterUrl)
    {
        if (string.IsNullOrWhiteSpace(embedUrl))
            return;

        platforms.Add(new NewsVideoPlatform
        {
            Key = key,
            Name = name,
            Url = url,
            EmbedUrl = embedUrl,
            PosterUrl = posterUrl
        });
    }

    private static string BuildYoutubeEmbedUrl(string url)
    {
        var match = Regex.Match(url ?? string.Empty, @"(?:youtube\.com/watch\?v=|youtube\.com/embed/|youtube\.com/shorts/|youtu\.be/)([A-Za-z0-9_-]{6,})", RegexOptions.IgnoreCase);
        return match.Success ? $"https://www.youtube.com/embed/{match.Groups[1].Value}" : string.Empty;
    }

    private static string BuildYoutubePosterUrl(string url)
    {
        var match = Regex.Match(url ?? string.Empty, @"(?:youtube\.com/watch\?v=|youtube\.com/embed/|youtube\.com/shorts/|youtu\.be/)([A-Za-z0-9_-]{6,})", RegexOptions.IgnoreCase);
        return match.Success ? $"https://img.youtube.com/vi/{match.Groups[1].Value}/hqdefault.jpg" : string.Empty;
    }

    private static string BuildRutubeEmbedUrl(string url)
    {
        var match = Regex.Match(url ?? string.Empty, @"rutube\.ru/(?:video|play/embed)/([A-Za-z0-9]+)", RegexOptions.IgnoreCase);
        return match.Success ? $"https://rutube.ru/play/embed/{match.Groups[1].Value}/" : string.Empty;
    }

    private static string BuildRutubePosterUrl(string url)
    {
        var match = Regex.Match(url ?? string.Empty, @"rutube\.ru/(?:video|play/embed)/([A-Za-z0-9]+)", RegexOptions.IgnoreCase);
        return match.Success ? $"https://rutube.ru/api/video/{match.Groups[1].Value}/thumbnail/?redirect=1" : string.Empty;
    }

    private static string BuildVkEmbedUrl(string url)
    {
        var match = Regex.Match(url ?? string.Empty, @"(?:video|clip)(-?\d+)_(\d+)", RegexOptions.IgnoreCase);
        return match.Success ? $"https://vk.com/video_ext.php?oid={match.Groups[1].Value}&id={match.Groups[2].Value}" : string.Empty;
    }

    private static string BuildNewsCardHtml(string markdown, string title)
    {
        var cardMarkdown = PickNewsCardMarkdown(markdown, title);
        return string.IsNullOrWhiteSpace(cardMarkdown)
            ? string.Empty
            : ToInlineNewsCardHtml(RenderMarkdownPreview(cardMarkdown));
    }

    private static List<string> GetMarkdownImages(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return new List<string>();

        return Regex.Matches(markdown, @"!\[[^\]]*\]\(([^)]+)\)")
            .Select(match => match.Groups[1].Value.Trim())
            .Where(image => !string.IsNullOrWhiteSpace(image))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string PickNewsCardMarkdown(string markdown, string title)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        var blocks = markdown
            .Replace("\r\n", "\n")
            .Replace('\r', '\n')
            .Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries);

        foreach (var block in blocks)
        {
            var trimmed = RemoveNewsCardSkippedMarkdownLines(block, title);
            if (string.IsNullOrWhiteSpace(trimmed) || string.IsNullOrWhiteSpace(StripNewsText(trimmed)))
            {
                continue;
            }

            return trimmed;
        }

        return string.Empty;
    }

    private static string RemoveNewsCardSkippedMarkdownLines(string block, string title)
    {
        var contentLines = string.Join("\n", block
            .Replace("\r\n", "\n")
            .Replace('\r', '\n')
            .Split('\n')
            .Select(line => line.Trim())
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .Where(line => !IsNewsCardSkippedMarkdownLine(line)));

        return string.Join("\n", contentLines
            .Split('\n')
            .Select(line => NormalizeNewsCardHeadingLine(line, title))
            .Where(line => !string.IsNullOrWhiteSpace(line))
        ).Trim();
    }

    private static bool IsNewsCardSkippedMarkdownLine(string line)
    {
        return Regex.IsMatch(line, @"^!\[[^\]]*\]\([^)]+\)$")
            || Regex.IsMatch(line, @"^@video(?:-vertical)?\(https?://[^)\s]+\)$", RegexOptions.IgnoreCase)
            || Regex.IsMatch(line, @"^https?://(?:www\.)?(?:youtube\.com/watch\?v=|youtube\.com/embed/|youtube\.com/shorts/|youtu\.be/|rutube\.ru/(?:video|play/embed)/|vk\.com/(?:video|clip))\S+$", RegexOptions.IgnoreCase);
    }

    private static string NormalizeNewsCardHeadingLine(string line, string title)
    {
        var normalizedLine = Regex.Replace(line, @"^#{1,6}\s+", string.Empty).Trim();
        return string.Equals(StripNewsText(normalizedLine), StripNewsText(title), StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : normalizedLine;
    }

    private static string ToInlineNewsCardHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return string.Empty;

        var inline = Regex.Replace(html, @"</p>\s*<p>", " ", RegexOptions.IgnoreCase);
        inline = Regex.Replace(inline, @"</?(?:p|h[1-6]|ul|ol|li|blockquote|figure)[^>]*>", " ", RegexOptions.IgnoreCase);
        inline = Regex.Replace(inline, @"<br\s*/?>", " ", RegexOptions.IgnoreCase);
        return Regex.Replace(inline, @"\s+", " ").Trim();
    }

    private static string StripNewsText(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        var text = Regex.Replace(markdown, @"!\[[^\]]*\]\([^)]+\)", string.Empty);
        text = Regex.Replace(text, @"^\s*@video(?:-vertical)?\(https?://[^)\s]+\)\s*$", string.Empty, RegexOptions.IgnoreCase | RegexOptions.Multiline);
        text = Regex.Replace(text, @"^\s*https?://(?:www\.)?(?:youtube\.com/watch\?v=|youtube\.com/embed/|youtube\.com/shorts/|youtu\.be/|rutube\.ru/(?:video|play/embed)/|vk\.com/(?:video|clip))\S+\s*$", string.Empty, RegexOptions.IgnoreCase | RegexOptions.Multiline);
        text = Regex.Replace(text, @"\[([^\]]+)\]\([^)]+\)", "$1");
        text = Regex.Replace(text, @"[#>*_`~\-]+", " ");
        return Regex.Replace(text, @"\s+", " ").Trim();
    }

    private static string RenderMarkdownPreview(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return "<p class=\"news-preview-empty\">Текст новости не заполнен.</p>";

        var blocks = markdown
            .Replace("\r\n", "\n")
            .Replace('\r', '\n')
            .Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries);

        return string.Join("\n", blocks.Select(RenderMarkdownBlock));
    }

    private static string RenderMarkdownBlock(string block)
    {
        var trimmed = block.Trim();
        var video = ExtractVideoEmbed(trimmed);
        if (!string.IsNullOrWhiteSpace(video))
            return $"<div class=\"news-preview-inline-video\"><iframe src=\"{HtmlEncoder.Default.Encode(video)}\" frameborder=\"0\" allow=\"clipboard-write; autoplay; encrypted-media; picture-in-picture\" allowfullscreen></iframe></div>";

        var imageMatch = Regex.Match(trimmed, @"^!\[[^\]]*\]\((?<url>[^)]+)\)$");
        if (imageMatch.Success)
        {
            var rawImageUrl = imageMatch.Groups["url"].Value.Trim();
            return $"<figure>{BuildPreviewImageHtml(rawImageUrl, string.Empty, string.Empty)}</figure>";
        }

        var safe = HtmlEncoder.Default.Encode(trimmed);
        safe = ReplaceInlineMarkdownImages(safe);
        safe = Regex.Replace(safe, @"^###\s+(.+)$", "<h3>$1</h3>", RegexOptions.Multiline);
        safe = Regex.Replace(safe, @"^##\s+(.+)$", "<h2>$1</h2>", RegexOptions.Multiline);
        safe = Regex.Replace(safe, @"^#\s+(.+)$", "<h1>$1</h1>", RegexOptions.Multiline);
        safe = Regex.Replace(safe, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        safe = Regex.Replace(safe, @"`(.+?)`", "<code>$1</code>");
        safe = Regex.Replace(safe, @"\[(?<text>[^\]]+)\]\((?<url>https?://[^)\s]+)\)", "<a href=\"${url}\" target=\"_blank\" rel=\"noopener noreferrer\">${text}</a>");

        return safe.StartsWith("<h", StringComparison.OrdinalIgnoreCase)
            ? safe
            : $"<p>{safe.Replace("\n", "<br />")}</p>";
    }

    private static string ReplaceInlineMarkdownImages(string htmlEncodedText)
    {
        return Regex.Replace(
            htmlEncodedText,
            @"!\[(?<alt>[^\]]*)\]\((?<url>[^)]+)\)",
            match =>
            {
                var rawImageUrl = System.Net.WebUtility.HtmlDecode(match.Groups["url"].Value.Trim());
                var altText = System.Net.WebUtility.HtmlDecode(match.Groups["alt"].Value.Trim());
                return BuildPreviewImageHtml(rawImageUrl, altText, "news-preview-inline-image");
            });
    }

    private static string BuildPreviewImageHtml(string rawImageUrl, string altText, string className)
    {
        var imageUrl = HtmlEncoder.Default.Encode(GetNewsPreviewUrl(rawImageUrl));
        var fallbackUrl = HtmlEncoder.Default.Encode(GetPublicImageFallbackUrl(rawImageUrl));
        var encodedAlt = HtmlEncoder.Default.Encode(altText ?? string.Empty);
        var encodedClass = string.IsNullOrWhiteSpace(className)
            ? string.Empty
            : $" class=\"{HtmlEncoder.Default.Encode(className)}\"";

        return $"<span{encodedClass}><img src=\"{imageUrl}\" data-news-preview-lightbox=\"{imageUrl}\" data-fallback-src=\"{fallbackUrl}\" alt=\"{encodedAlt}\" loading=\"lazy\" onerror=\"var fallback=this.dataset.fallbackSrc;if(fallback&&this.src.indexOf(fallback)<0){{this.src=fallback;this.dataset.newsPreviewLightbox=fallback;}}else{{this.closest('.news-preview-inline-image')?.remove();this.remove();}}\" /></span>";
    }

    private static string ExtractVideoEmbed(string text)
    {
        var macro = Regex.Match(text, @"^@video(?:-vertical)?\((?<url>https?://[^)\s]+)\)$", RegexOptions.IgnoreCase);
        var url = macro.Success ? macro.Groups["url"].Value : text;
        if (!Regex.IsMatch(url, @"^https?://\S+$", RegexOptions.IgnoreCase))
            return string.Empty;

        return PickText(BuildYoutubeEmbedUrl(url), PickText(BuildRutubeEmbedUrl(url), BuildVkEmbedUrl(url)));
    }
}

<div class="container top with_left_side">
    <section class="admin-workspace news-preview-workspace">
        @if (news == null)
        {
            <div class="admin-alert danger">Новость не найдена.</div>
        }
        else
        {
            <div class="news-preview-toolbar">
                <a class="admin-button muted" href="/news">Назад к новостям</a>
                <a class="admin-button @(isRussian ? "primary" : "muted")" href="/news/preview/@news.Id?culture=ru">RU</a>
                <a class="admin-button @(!isRussian ? "primary" : "muted")" href="/news/preview/@news.Id?culture=en">EN</a>
                <span class="news-preview-state @(news.IsPublished ? "published" : "hidden")">@(news.IsPublished ? "опубликована" : "скрыта")</span>
            </div>

            <div class="news-preview-section-title">
                <span>Карточка в списке новостей</span>
                <small>Краткий текст собирается из Markdown без изображений и видео.</small>
            </div>

            <article class="news-preview-list-card @(hasCardImage ? "has-image" : "no-image")">
                @if (hasCardImage)
                {
                    <img class="news-preview-list-image" src="@cardImageUrl" data-news-preview-lightbox="@cardImageUrl" data-fallback-src="@cardImageFallbackUrl" alt="" loading="lazy" onerror="var fallback=this.dataset.fallbackSrc;if(fallback&&this.src.indexOf(fallback)<0){this.src=fallback;this.dataset.newsPreviewLightbox=fallback;}else{this.closest('.news-preview-list-card')?.classList.add('no-image');this.remove();}" />
                }
                <div class="news-preview-list-content">
                    <div class="news-preview-list-meta">
                        <span class="news-preview-type">@PickText(newsType, "News")</span>
                        <time>@publishedAt</time>
                    </div>
                    <h2>@title</h2>
                    @if (!string.IsNullOrWhiteSpace(cardHtml))
                    {
                        <div class="news-preview-card-markdown">
                            @Html.Raw(cardHtml)
                        </div>
                    }
                    else
                    {
                        <p class="news-preview-empty">Для карточки нет текстового фрагмента: начало новости состоит только из медиа или пустого Markdown.</p>
                    }
                    @if (videoPlatforms.Count > 0)
                    {
                        <div class="news-preview-video-links card-links">
                            @foreach (var platform in videoPlatforms)
                            {
                                <a class="@(platform == videoPlatforms[0] ? "active" : string.Empty)" href="@platform.Url" target="_blank" rel="noopener noreferrer">@platform.Name</a>
                            }
                        </div>
                    }
                    <div class="news-preview-list-actions">
                        <span>★ @Math.Max(0, news.LikeCount)</span>
                        <span>Читать полностью</span>
                    </div>
                </div>
            </article>

            <div class="news-preview-section-title">
                <span>Полный текст новости</span>
                <small>Так статья выглядит при открытии полного чтения.</small>
            </div>

            <article class="news-preview-card">
                @if (!string.IsNullOrWhiteSpace(coverUrl))
                {
                    <img class="news-preview-cover" src="@coverUrl" data-news-preview-lightbox="@coverUrl" data-fallback-src="@GetPublicImageFallbackUrl(news.ImageUrl)" alt="" loading="lazy" onerror="var fallback=this.dataset.fallbackSrc;if(fallback&&this.src.indexOf(fallback)<0){this.src=fallback;this.dataset.newsPreviewLightbox=fallback;}else{this.remove();}" />
                }
                <header class="news-preview-header">
                    @if (!string.IsNullOrWhiteSpace(iconUrl))
                    {
                        <img class="news-preview-icon" src="@iconUrl" data-fallback-src="@GetPublicImageFallbackUrl(news.IconUrl)" alt="" loading="lazy" onerror="var fallback=this.dataset.fallbackSrc;if(fallback&&this.src.indexOf(fallback)<0){this.src=fallback;}else{this.remove();}" />
                    }
                    <div>
                        <span class="news-preview-type">@PickText(newsType, "News")</span>
                        <h1>@title</h1>
                        <time>@publishedAt</time>
                    </div>
                </header>

                @if (videoPlatforms.Count > 0)
                {
                    <div class="news-preview-video">
                        <iframe src="@videoPlatforms[0].EmbedUrl" frameborder="0" allow="clipboard-write; autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
                    </div>
                    <div class="news-preview-video-links">
                        @foreach (var platform in videoPlatforms)
                        {
                            <a href="@platform.Url" target="_blank" rel="noopener noreferrer">@platform.Name</a>
                        }
                    </div>
                }

                <div class="news-preview-markdown">
                    @Html.Raw(RenderMarkdownPreview(markdown))
                </div>

                @if (rawGalleryUrls.Count > 0)
                {
                    <div class="news-preview-gallery">
                        @foreach (var imageUrl in rawGalleryUrls)
                        {
                            var previewUrl = GetNewsPreviewUrl(imageUrl);
                            var fallbackUrl = GetPublicImageFallbackUrl(imageUrl);
                            <img src="@previewUrl" data-news-preview-lightbox="@previewUrl" data-fallback-src="@fallbackUrl" alt="" loading="lazy" onerror="var fallback=this.dataset.fallbackSrc;if(fallback&&this.src.indexOf(fallback)<0){this.src=fallback;this.dataset.newsPreviewLightbox=fallback;}else{this.remove();}" />
                        }
                    </div>
                }
            </article>
        }
    </section>
</div>

<script>
    (() => {
        const escapeAttribute = (value) => String(value || "")
            .replace(/&/g, "&amp;")
            .replace(/"/g, "&quot;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");

        const openLightbox = (imageUrl, altText) => {
            if (!imageUrl)
                return;

            document.querySelector(".news-preview-lightbox")?.remove();
            const lightbox = document.createElement("div");
            lightbox.className = "news-preview-lightbox";
            lightbox.innerHTML = `
                <button type="button" aria-label="Закрыть">&times;</button>
                <img src="${escapeAttribute(imageUrl)}" alt="${escapeAttribute(altText)}" />
            `;

            const close = () => {
                lightbox.remove();
                document.body.classList.remove("news-preview-lightbox-open");
            };

            lightbox.addEventListener("click", (event) => {
                if (event.target === lightbox)
                    close();
            });
            lightbox.querySelector("button")?.addEventListener("click", close);
            document.body.classList.add("news-preview-lightbox-open");
            document.body.appendChild(lightbox);
        };

        document.addEventListener("click", (event) => {
            const image = event.target instanceof HTMLImageElement ? event.target : null;
            if (!image || !image.dataset.newsPreviewLightbox)
                return;

            event.preventDefault();
            openLightbox(image.dataset.newsPreviewLightbox || image.currentSrc || image.src, image.alt || "");
        });

        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape")
                return;

            document.querySelector(".news-preview-lightbox")?.remove();
            document.body.classList.remove("news-preview-lightbox-open");
        });
    })();
</script>
